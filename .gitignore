# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
*.translation

# Imported textures and samples
.import/

# Exported builds and artifacts
export/
exports/
builds/
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.x86_32
*.pck
*.idsig

# Generated sprite resources (contain embedded pixel data, regenerated by sprite pipeline)
# Source PNGs in assets/ are tracked — these .tres files are pipeline output
resources/player_sprites.tres
resources/enemies/*_sprites.tres

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Editor settings
*.cfg
!export_presets.cfg

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Android build
android/build/
.gradle/

# iOS build
*.xcworkspace/
*.xcodeproj/

# 3D import sources (large binaries, not needed in repo)
assets/3d_imports/

# Captured spritesheets (intermediate renders before pixel art conversion)
assets/sprites/captures/

# Final exported sprite sheets (regenerated by sprite pipeline wizard)
assets/sprites/final/

# Sprite pipeline presets (per-model camera/pixel art settings)
assets/sprites/presets/

# Backup files
*.bak

# Temporary/debug files (Claude Code artifacts, test scripts)
temp_*.txt
fix*.txt
test_write*.txt
fix_script.py
run_fix.py

# Old standalone Excel files (VBA source is in databases/vba/, master DB is .xlsm)
databases/*.xlsx

# Debug screenshots and test images
debug/
